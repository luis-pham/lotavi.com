NODE_ENV=development
# memory | postgres
# production|staging MUST use postgres (fail-fast enforced)
LOTIVA_STORE=memory
# Required when LOTIVA_STORE=memory outside NODE_ENV=test
ALLOW_MEMORY_STORE=true
# Dev-only public GET /api/v1/meta/seed — MUST be false in staging/production
ALLOW_DEMO_SEED=true
DATABASE_URL=postgres://lotiva:lotiva@localhost:5432/lotiva
REDIS_URL=redis://localhost:6379
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Canonical marketing origin (no trailing slash)
PUBLIC_WEB_URL=https://lotavi.com
NEXT_PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_APP_URL=https://app.lotavi.com
PUBLIC_API_URL=https://api.lotavi.com
STAGING_WEB_URL=https://staging.lotavi.com
STAGING_API_URL=https://api.staging.lotavi.com
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=vi,en
LOCALE_COOKIE_NAME=lotavi_locale
NEXT_PUBLIC_SITE_ENV=development
# Min 32 chars required in staging/production
SESSION_SECRET=dev-only-change-me-to-a-long-random-secret
GUEST_COOKIE_NAME=lotiva_guest
STAFF_COOKIE_NAME=lotiva_staff
EMBEDDING_SERVICE_URL=http://localhost:8081
# model | stub — production must use model + mounted EmbeddingGemma weights
EMBEDDING_BACKEND=stub
EMBEDDING_ALLOW_STUB=true
EMBEDDING_MODEL_ID=google/embeddinggemma-300m
EMBEDDING_MODEL_PATH=
EMBEDDING_TIMEOUT_MS=30000
# Voice off by default; enable only with real GEMINI_API_KEY
VOICE_ENABLED=false
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:3000,https://lotavi.com,https://app.lotavi.com,https://staging.lotavi.com
PUBLIC_APP_HOST=localhost:3000
LOG_LEVEL=info
SEED_ADMIN_PASSWORD=admin123
RUN_PG_TESTS=0
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lotiva-dev
